{
  "name": "casechamp-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "build": "npm run generate && tsc --noEmit && vite build",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "npm run generate && vitest run tests",
    "test:e2e": "playwright test",
    "demo:record": "playwright test --config=playwright.demo.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
