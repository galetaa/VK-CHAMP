{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "resolveJsonModule": true, "verbatimModuleSyntax": true, "jsx": "react-jsx",
    "skipLibCheck": true, "noEmit": true, "types": ["vite/client", "node"],
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "playwright.demo.config.ts", "tests", "e2e"]
}
